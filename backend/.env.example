# ── Claude API (Anthropic) ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Upstash Redis (history, live progress, YouTube tokens) ─
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── Rendering on GitHub Actions ─────────────────────────
# Fine-grained token for this repo with "Actions: Read and write"
GH_DISPATCH_TOKEN=
GH_REPO=Om-1008/autotube

# ── Pixabay stock footage (free key: pixabay.com/api/docs) ─
PIXABAY_API_KEY=

# ── Voice (edge-tts neural voice; Google TTS fallback) ──
TTS_VOICE=en-US-AndrewNeural

# ── YouTube / Google OAuth ──────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/auth/youtube/callback
YOUTUBE_PRIVACY=public

# ── Email notifications (Gmail app password, optional) ──
EMAIL_USER=
EMAIL_PASS=
NOTIFY_EMAIL=

# ── App settings ───────────────────────────────────────
PORT=4000
DASHBOARD_URL=http://localhost:3000
CHANNEL_NICHE=personal finance
CHANNEL_AUDIENCE=global English
VIDEO_FREQUENCY_DAYS=2
